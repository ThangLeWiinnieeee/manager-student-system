DB_URL=jdbc:postgresql://localhost:5432/student_topic_management
DB_USERNAME=root2202
DB_PASSWORD=anhtu
ADMIN_EMAIL=admin@fit.edu.vn
ADMIN_PASSWORD=ChangeThisPassword123!

# Set these to your SMTP provider. Never commit real SMTP credentials.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Local reports directory (relative to the project when using run.ps1).
REPORT_STORAGE_DIR=./uploads/reports

# Optional remote report storage. Use the legacy service_role JWT server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reports

# HTTPS email for Render Free; MAIL_FROM must be verified in Brevo.
BREVO_API_KEY=

# Gmail HTTPS API takes priority over Brevo/SMTP when all three are set.
# MAIL_FROM must be the Gmail account that authorized the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
